   "source": [
    "# Find top 3 private partners for each public JHS (using GREEDY results)\n",
    "# Aggregate by (public JHS, private ESC) pair first - include tuition\n",
    "partner_agg = redirections.groupby(\n",
    "    ['school_id_destination', 'private_esc_id']\n",
    ").agg({\n",
    "    'count_redirected': 'sum',\n",
    "    'tuition_jhs': 'first'  # Tuition is same for all rows with same private_esc_id\n",
    "}).reset_index()\n",
    "\n",
    "# Rank partners within each public JHS\n",
    "partner_agg['rank'] = partner_agg.groupby('school_id_destination')['count_redirected'].rank(\n",
    "    method='first', ascending=False\n",
    ").astype(int)\n",
    "\n",
    "# Get top 3 partners\n",
    "top3 = partner_agg[partner_agg['rank'] <= 3].copy()\n",
    "\n",
    "# Add private school names\n",
    "top3 = top3.merge(\n",
    "    sch_info_slim[['school_id', 'school_name']],\n",
    "    left_on='private_esc_id',\n",
    "    right_on='school_id',\n",
    "    how='left'\n",
    ").drop(columns='school_id')\n",
    "top3.rename(columns={'school_name': 'private_esc_name'}, inplace=True)\n",
    "\n",
    "# Add distance from public JHS to private ESC (from distance matrix)\n",
    "def get_distance_km(row):\n",
    "    pub_id = row['school_id_destination']\n",
    "    priv_id = row['private_esc_id']\n",
    "    if pub_id in re_schids_to_idx and priv_id in re_schids_to_idx:\n",
    "        pub_idx = re_schids_to_idx[pub_id]\n",
    "        priv_idx = re_schids_to_idx[priv_id]\n",
    "        return dm[pub_idx, priv_idx] / 1000  # Convert to km\n",
    "    return np.nan\n",
    "\n",
    "top3['distance_km'] = top3.apply(get_distance_km, axis=1)\n",
    "\n",
    "# Pivot to wide format (one row per public JHS) - now includes tuition\n",
    "top3_wide = top3.pivot(\n",
    "    index='school_id_destination',\n",
    "    columns='rank',\n",
    "    values=['private_esc_id', 'private_esc_name', 'count_redirected', 'distance_km', 'tuition_jhs']\n",
    ")\n",
    "\n",
    "# Flatten column names\n",
    "top3_wide.columns = [f'{col[0]}_{col[1]}' for col in top3_wide.columns]\n",
    "top3_wide = top3_wide.reset_index()\n",
    "top3_wide.rename(columns={'school_id_destination': 'school_id'}, inplace=True)\n",
    "\n",
    "# Rename columns to be more descriptive\n",
    "rename_map = {\n",
    "    'private_esc_id_1': 'top_partner_1_id',\n",
    "    'private_esc_id_2': 'top_partner_2_id',\n",
    "    'private_esc_id_3': 'top_partner_3_id',\n",
    "    'private_esc_name_1': 'top_partner_1_name',\n",
    "    'private_esc_name_2': 'top_partner_2_name',\n",
    "    'private_esc_name_3': 'top_partner_3_name',\n",
    "    'count_redirected_1': 'top_partner_1_redirected',\n",
    "    'count_redirected_2': 'top_partner_2_redirected',\n",
    "    'count_redirected_3': 'top_partner_3_redirected',\n",
    "    'distance_km_1': 'top_partner_1_distance_km',\n",
    "    'distance_km_2': 'top_partner_2_distance_km',\n",
    "    'distance_km_3': 'top_partner_3_distance_km',\n",
    "    'tuition_jhs_1': 'top_partner_1_tuition',\n",
    "    'tuition_jhs_2': 'top_partner_2_tuition',\n",
    "    'tuition_jhs_3': 'top_partner_3_tuition'\n",
    "}\n",
    "top3_wide.rename(columns=rename_map, inplace=True)\n",
    "\n",
    "# Merge with report1\n",
    "report1 = report1.merge(top3_wide, on='school_id', how='left')\n",
    "\n",
    "# Sort by baseline aisle learners descending\n",
    "report1 = report1.sort_values('aisle_learners_baseline', ascending=False)\n",
    "\n",
    "print(f\"Report 1 final shape: {report1.shape}\")\n",
    "print(f\"\\nTop 3 partner columns added (from GREEDY algorithm):\")\n",
    "print(\"  - top_partner_1_id, top_partner_1_name, top_partner_1_redirected, top_partner_1_distance_km, top_partner_1_tuition\")\n",
    "print(\"  - top_partner_2_id, top_partner_2_name, top_partner_2_redirected, top_partner_2_distance_km, top_partner_2_tuition\")\n",
    "print(\"  - top_partner_3_id, top_partner_3_name, top_partner_3_redirected, top_partner_3_distance_km, top_partner_3_tuition\")\n",
    "display(report1[['school_id', 'school_name', 'aisle_learners_baseline', \n",
    "                 'top_partner_1_name', 'top_partner_1_redirected', 'top_partner_1_tuition',\n",
    "                 'top_partner_2_name', 'top_partner_2_redirected', 'top_partner_2_tuition',\n",
    "                 'top_partner_3_name', 'top_partner_3_redirected', 'top_partner_3_tuition']].head(10))"
   ]
  },
  {
