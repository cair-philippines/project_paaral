   "source": [
    "# Add public JHS info\n",
    "report2 = pair_agg.merge(\n",
    "    df_cong[['school_id', 'school_name', 'division', 'count_aisle_learner_jhs']],\n",
    "    left_on='public_jhs_id',\n",
    "    right_on='school_id',\n",
    "    how='left'\n",
    ").drop(columns='school_id')\n",
    "report2.rename(columns={\n",
    "    'school_name': 'public_jhs_name',\n",
    "    'division': 'public_jhs_division',\n",
    "    'count_aisle_learner_jhs': 'public_jhs_aisle_learners'\n",
    "}, inplace=True)\n",
    "\n",
    "# Add private ESC info\n",
    "report2 = report2.merge(\n",
    "    sch_info_slim[['school_id', 'school_name', 'division']],\n",
    "    left_on='private_esc_id',\n",
    "    right_on='school_id',\n",
    "    how='left'\n",
    ").drop(columns='school_id')\n",
    "report2.rename(columns={\n",
    "    'school_name': 'private_esc_name',\n",
    "    'division': 'private_esc_division'\n",
    "}, inplace=True)\n",
    "\n",
    "# Add ESC slots info\n",
    "report2 = report2.merge(\n",
    "    esc_available[['school_id', 'total_count_slots', 'available_slots']],\n",
    "    left_on='private_esc_id',\n",
    "    right_on='school_id',\n",
    "    how='left'\n",
    ").drop(columns='school_id')\n",
    "report2.rename(columns={'available_slots': 'available_slots_before'}, inplace=True)\n",
    "\n",
    "# Calculate percentage of public's relief from this private\n",
    "total_redirected_per_public = report2.groupby('public_jhs_id')['count_redirected'].transform('sum')\n",
    "report2['pct_of_public_relief'] = (report2['count_redirected'] / total_redirected_per_public) * 100\n",
    "\n",
    "# Reorder columns\n",
    "report2 = report2[[\n",
    "    'public_jhs_id', 'public_jhs_name', 'public_jhs_division', 'public_jhs_aisle_learners',\n",
    "    'private_esc_id', 'private_esc_name', 'private_esc_division',\n",
    "    'total_count_slots', 'available_slots_before',\n",
    "    'count_redirected', 'avg_distance_km', 'pct_of_public_relief', 'num_origin_schools'\n",
    "]]\n",
    "\n",
    "# Sort by count_redirected descending\n",
    "report2 = report2.sort_values('count_redirected', ascending=False)\n",
    "\n",
    "print(f\"Report 2 shape: {report2.shape}\")\n",
    "display(report2.head(10))"
   ]
  },
