   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "=====================================================================================\n",
      "STAKEHOLDER COMPARISON TABLE: Baseline vs Greedy vs LP Optimization\n",
      "=====================================================================================\n",
      "Metric                                         Baseline   After Greedy       After LP\n",
      "-------------------------------------------------------------------------------------\n",
      "Total aisle learners                            689,568        663,117        663,074\n",
      "Students redirected (new)                             —         26,451         26,494\n",
      "Reduction from baseline                               —           3.8%           3.8%\n",
      "Schools fully relieved                                0            285            291\n",
      "Private ESC schools used                          1,026            950            949\n",
      "Avg redirect distance (km)                        12.68           2.50           3.36\n",
      "Slot utilization (cumulative)                    65.51%        100.00%        100.06%\n",
      "=====================================================================================\n",
      "\n",
      "NOTES:\n",
      "  - Baseline: Current ESC program state (existing beneficiaries already enrolled)\n",
      "  - Greedy: Priority-based selection (addresses most congested schools first)\n",
      "  - LP: System-wide optimization (finds global optimal redistribution)\n",
      "  - Distance constraint: 5 km from origin ES to private ESC\n",
      "  - Total ESC slots in region: 76,689\n",
      "  - Currently occupied: 50,241 (65.5%)\n",
      "  - Available for redistribution: 27,141\n"
     ]
    }
   ],
   "source": [
    "# Calculate Greedy statistics\n",
    "greedy_redirected = redirections['count_redirected'].sum()\n",
    "greedy_aisle = baseline_aisle - greedy_redirected\n",
    "greedy_reduction_pct = ((baseline_aisle - greedy_aisle) / baseline_aisle) * 100\n",
    "greedy_schools_relieved = (report1['aisle_learners_greedy'] <= 0).sum()\n",
    "\n",
    "# Calculate Greedy avg distance (weighted by students redirected)\n",
    "greedy_distances = []\n",
    "greedy_weights = []\n",
    "for _, row in redirections.iterrows():\n",
    "    if row['count_redirected'] > 0:\n",
    "        greedy_distances.append(row['distance_to_private_km'])\n",
    "        greedy_weights.append(row['count_redirected'])\n",
    "greedy_avg_distance = np.average(greedy_distances, weights=greedy_weights) if greedy_weights else np.nan\n",
    "\n",
    "# Calculate LP statistics\n",
    "lp_redirected = redirections_lp['count_redirected_lp'].sum()\n",
    "lp_reduction_pct = ((baseline_aisle - lp_aisle) / baseline_aisle) * 100\n",
    "lp_schools_relieved = (report1['is_fully_relieved'] == True).sum()\n",
    "\n",
    "# Calculate LP avg distance (weighted by students redirected)\n",
    "lp_distances = []\n",
    "lp_weights = []\n",
    "for _, row in redirections_lp.iterrows():\n",
    "    if row['count_redirected_lp'] > 0:\n",
    "        lp_distances.append(row['distance_to_private_km'])\n",
    "        lp_weights.append(row['count_redirected_lp'])\n",
    "lp_avg_distance = np.average(lp_distances, weights=lp_weights) if lp_weights else np.nan\n",
    "\n",
    "# CONSISTENT Slot utilization metric: cumulative (current + new) / total_slots\n",
    "# This shows how total capacity utilization changes with each intervention\n",
    "greedy_cumulative_utilization = ((total_current_beneficiaries + greedy_redirected) / total_slots) * 100\n",
    "lp_cumulative_utilization = ((total_current_beneficiaries + lp_redirected) / total_slots) * 100\n",
    "\n",
    "# Count ESC schools used by Greedy and LP\n",
    "greedy_esc_schools_used = redirections['private_esc_id'].nunique()\n",
    "lp_esc_schools_used = len(used_private_ids)\n",
    "\n",
    "print(\"=\"*85)\n",
    "print(\"STAKEHOLDER COMPARISON TABLE: Baseline vs Greedy vs LP Optimization\")\n",
    "print(\"=\"*85)\n",
    "print(f\"{'Metric':<40} {'Baseline':>14} {'After Greedy':>14} {'After LP':>14}\")\n",
    "print(\"-\"*85)\n",
    "print(f\"{'Total aisle learners':<40} {baseline_aisle:>14,.0f} {greedy_aisle:>14,.0f} {lp_aisle:>14,.0f}\")\n",
    "print(f\"{'Students redirected (new)':<40} {'—':>14} {greedy_redirected:>14,.0f} {lp_redirected:>14,.0f}\")\n",
    "print(f\"{'Reduction from baseline':<40} {'—':>14} {greedy_reduction_pct:>13.1f}% {lp_reduction_pct:>13.1f}%\")\n",
    "print(f\"{'Schools fully relieved':<40} {0:>14} {greedy_schools_relieved:>14} {lp_schools_relieved:>14}\")\n",
    "print(f\"{'Private ESC schools used':<40} {baseline_esc_schools_used:>14,} {greedy_esc_schools_used:>14,} {lp_esc_schools_used:>14,}\")\n",
    "print(f\"{'Avg redirect distance (km)':<40} {baseline_avg_distance_km:>14.2f} {greedy_avg_distance:>14.2f} {lp_avg_distance:>14.2f}\")\n",
    "print(f\"{'Slot utilization (cumulative)':<40} {baseline_slot_utilization:>13.2f}% {greedy_cumulative_utilization:>13.2f}% {lp_cumulative_utilization:>13.2f}%\")\n",
    "print(\"=\"*85)\n",
    "\n",
    "print(\"\\nNOTES:\")\n",
    "print(\"  - Baseline: Current ESC program state (existing beneficiaries already enrolled)\")\n",
    "print(\"  - Greedy: Priority-based selection (addresses most congested schools first)\")\n",
    "print(\"  - LP: System-wide optimization (finds global optimal redistribution)\")\n",
    "print(f\"  - Distance constraint: {MAX_DISTANCE_KM} km from origin ES to private ESC\")\n",
    "print(f\"  - Total ESC slots in region: {total_slots:,.0f}\")\n",
    "print(f\"  - Currently occupied: {total_current_beneficiaries:,.0f} ({baseline_slot_utilization:.1f}%)\")\n",
    "print(f\"  - Available for redistribution: {esc_available['available_slots'].sum():,.0f}\")"
   ]
  },
