   "source": [
    "# Build Report 4A: Student Flow Changes (Greedy)\n",
    "\n",
    "# Start with all flows to congested public JHS\n",
    "report4a = flow_to_congested[['school_id_origin', 'school_id_destination', \n",
    "                               'count_esc_beneficiary', 'count_non_beneficiary']].copy()\n",
    "report4a['original_total'] = report4a[['count_esc_beneficiary','count_non_beneficiary']].sum(axis=1)\n",
    "report4a.rename(columns={\n",
    "    'count_esc_beneficiary': 'original_beneficiaries',\n",
    "    'count_non_beneficiary': 'original_non_beneficiaries'\n",
    "}, inplace=True)\n",
    "\n",
    "# Aggregate Greedy redirections by (origin, destination)\n",
    "greedy_by_flow = redirections.groupby(\n",
    "    ['school_id_origin', 'school_id_destination']\n",
    ").agg({\n",
    "    'count_redirected': 'sum',\n",
    "    'private_esc_id': 'nunique'\n",
    "}).reset_index()\n",
    "greedy_by_flow.columns = ['school_id_origin', 'school_id_destination', 'students_redirected', 'num_private_partners']\n",
    "\n",
    "# Find top private ESC per flow (most students redirected)\n",
    "top_private_greedy = redirections.loc[\n",
    "    redirections.groupby(['school_id_origin', 'school_id_destination'])['count_redirected'].idxmax()\n",
    "][['school_id_origin', 'school_id_destination', 'private_esc_id', 'count_redirected', 'distance_to_private_km']].copy()\n",
    "top_private_greedy.columns = ['school_id_origin', 'school_id_destination', \n",
    "                               'top_private_esc_id', 'top_private_count', 'distance_origin_to_top_private_km']\n",
    "\n",
    "# Merge redirections with original flow\n",
    "report4a = report4a.merge(greedy_by_flow, on=['school_id_origin', 'school_id_destination'], how='left')\n",
    "report4a['students_redirected'] = report4a['students_redirected'].fillna(0)\n",
    "report4a['num_private_partners'] = report4a['num_private_partners'].fillna(0).astype(int)\n",
    "\n",
    "# Merge top private ESC info\n",
    "report4a = report4a.merge(top_private_greedy, on=['school_id_origin', 'school_id_destination'], how='left')\n",
    "\n",
    "# Calculate remaining and percentage\n",
    "report4a['remaining_non_beneficiaries'] = report4a['original_non_beneficiaries'] - report4a['students_redirected']\n",
    "report4a['pct_redirected'] = np.where(\n",
    "    report4a['original_non_beneficiaries'] > 0,\n",
    "    (report4a['students_redirected'] / report4a['original_non_beneficiaries']) * 100,\n",
    "    0\n",
    ")\n",
    "\n",
    "# Add origin school info\n",
    "report4a = report4a.merge(\n",
    "    sch_info_slim[['school_id', 'school_name', 'division']],\n",
    "    left_on='school_id_origin',\n",
    "    right_on='school_id',\n",
    "    how='left'\n",
    ").drop(columns='school_id')\n",
    "report4a.rename(columns={'school_name': 'school_name_origin', 'division': 'division_origin'}, inplace=True)\n",
    "\n",
    "# Add destination school info\n",
    "report4a = report4a.merge(\n",
    "    sch_info_slim[['school_id', 'school_name', 'division']],\n",
    "    left_on='school_id_destination',\n",
    "    right_on='school_id',\n",
    "    how='left'\n",
    ").drop(columns='school_id')\n",
    "report4a.rename(columns={'school_name': 'school_name_destination', 'division': 'division_destination'}, inplace=True)\n",
    "\n",
    "# Add top private ESC name\n",
    "report4a = report4a.merge(\n",
    "    sch_info_slim[['school_id', 'school_name']],\n",
    "    left_on='top_private_esc_id',\n",
    "    right_on='school_id',\n",
    "    how='left'\n",
    ").drop(columns='school_id')\n",
    "report4a.rename(columns={'school_name': 'top_private_esc_name'}, inplace=True)\n",
    "\n",
    "# Reorder columns\n",
    "report4a = report4a[[\n",
    "    'school_id_origin', 'school_name_origin', 'division_origin',\n",
    "    'school_id_destination', 'school_name_destination', 'division_destination',\n",
    "    'original_total', 'original_beneficiaries', 'original_non_beneficiaries',\n",
    "    'students_redirected', 'remaining_non_beneficiaries', 'pct_redirected',\n",
    "    'num_private_partners', 'top_private_esc_id', 'top_private_esc_name', \n",
    "    'top_private_count', 'distance_origin_to_top_private_km'\n",
    "]]\n",
    "\n",
    "# Sort by students_redirected descending\n",
    "report4a = report4a.sort_values('students_redirected', ascending=False)\n",
    "\n",
    "print(f\"Report 4A shape: {report4a.shape}\")\n",
    "print(f\"Flows with redirections: {(report4a['students_redirected'] > 0).sum():,}\")\n",
    "print(f\"Flows without redirections: {(report4a['students_redirected'] == 0).sum():,}\")\n",
    "display(report4a.head(10))"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "u6sul1olvdg",
   "metadata": {},
