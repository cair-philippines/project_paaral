   "source": [
    "# Set objective and solve\n",
    "prob += lpSum([x[idx] for idx in redirection_options.index]), \"Total_Redirections\"\n",
    "\n",
    "print(\"Solving LP...\")\n",
    "prob.solve()\n",
    "print(f\"Status: {LpStatus[prob.status]}\")\n",
    "print(f\"Optimal value (total redirections): {value(prob.objective):,.0f}\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 28,
   "id": "k2l3m4n5",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "LP redirections: 5,763\n",
      "Total students redirected (LP): 26,494\n"
     ]
    }
   ],
   "source": [
    "# Extract LP results\n",
    "redirection_options_lp = redirection_options.copy()\n",
    "redirection_options_lp['count_redirected_lp'] = [value(x[idx]) for idx in redirection_options.index]\n",
    "\n",
    "redirections_lp = redirection_options_lp[redirection_options_lp['count_redirected_lp'] > 0].copy()\n",
    "\n",
    "print(f\"LP redirections: {len(redirections_lp):,}\")\n",
    "print(f\"Total students redirected (LP): {redirections_lp['count_redirected_lp'].sum():,.0f}\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 29,
   "id": "l2m3n4o5",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Baseline aisle learners: 689,568\n",
      "LP aisle learners: 663,074\n",
      "LP reduction: 26,494 (3.8%)\n"
     ]
    }
   ],
   "source": [
    "# Create LP congestion results\n",
    "redirections_by_dest_lp = redirections_lp.groupby('school_id_destination')['count_redirected_lp'].sum().to_dict()\n",
    "\n",
    "scenario1_lp_congestion = df_cong.copy()\n",
    "scenario1_lp_congestion['redirected_lp'] = scenario1_lp_congestion['school_id'].map(redirections_by_dest_lp).fillna(0)\n",
    "scenario1_lp_congestion['count_aisle_learner_jhs_lp'] = (\n",
    "    scenario1_lp_congestion['count_aisle_learner_jhs'] - scenario1_lp_congestion['redirected_lp']\n",
    ")\n",
    "scenario1_lp_congestion['aisle_learner_reduction_lp'] = scenario1_lp_congestion['redirected_lp']\n",
    "\n",
    "lp_aisle = scenario1_lp_congestion['count_aisle_learner_jhs_lp'].sum()\n",
    "print(f\"Baseline aisle learners: {baseline_aisle:,.0f}\")\n",
    "print(f\"LP aisle learners: {lp_aisle:,.0f}\")\n",
    "print(f\"LP reduction: {baseline_aisle - lp_aisle:,.0f} ({((baseline_aisle - lp_aisle)/baseline_aisle)*100:.1f}%)\")"
   ]
  },
