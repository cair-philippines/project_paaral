   "source": [
    "# Start with congestion table\n",
    "report1 = df_cong[['school_id', 'school_name', 'division', 'old_region', \n",
    "                   'enrollment_jhs', 'seat_count', 'count_aisle_learner_jhs']].copy()\n",
    "report1.columns = ['school_id', 'school_name', 'division', 'region',\n",
    "                   'enrollment_jhs', 'seat_count', 'aisle_learners_baseline']\n",
    "\n",
    "# Add greedy results\n",
    "greedy_by_dest = redirections.groupby('school_id_destination')['count_redirected'].sum().to_dict()\n",
    "report1['redirected_greedy'] = report1['school_id'].map(greedy_by_dest).fillna(0)\n",
    "report1['aisle_learners_greedy'] = report1['aisle_learners_baseline'] - report1['redirected_greedy']\n",
    "report1['pct_reduction_greedy'] = np.where(\n",
    "    report1['aisle_learners_baseline'] > 0,\n",
    "    (report1['redirected_greedy'] / report1['aisle_learners_baseline']) * 100,\n",
    "    0\n",
    ")\n",
    "\n",
    "# Add LP results\n",
    "report1['redirected_lp'] = report1['school_id'].map(redirections_by_dest_lp).fillna(0)\n",
    "report1['aisle_learners_lp'] = report1['aisle_learners_baseline'] - report1['redirected_lp']\n",
    "report1['pct_reduction_lp'] = np.where(\n",
    "    report1['aisle_learners_baseline'] > 0,\n",
    "    (report1['redirected_lp'] / report1['aisle_learners_baseline']) * 100,\n",
    "    0\n",
    ")\n",
    "\n",
    "# Is fully relieved?\n",
    "report1['is_fully_relieved'] = report1['aisle_learners_lp'] <= 0\n",
    "\n",
    "print(f\"Report 1 shape: {report1.shape}\")\n",
    "display(report1.head())"
   ]
  },
