   "source": [
    "# Get all public JHS in NCR/Region IV-A\n",
    "mask = (\n",
    "    (sch_info_slim['sector'] == 'Public')\n",
    "    & (sch_info_slim['offers_jhs'] == True)\n",
    "    & (sch_info_slim['old_region'].isin(['NCR', 'Region IV-A']))\n",
    ")\n",
    "all_public_jhs = sch_info_slim.loc[mask, ['school_id', 'school_name', 'division', 'old_region']].copy()\n",
    "print(f\"All public JHS in NCR/Region IV-A: {all_public_jhs.shape[0]:,}\")\n",
    "\n",
    "# Schools included in optimization (in df_cong with aisle learners > 0)\n",
    "included_ids = set(df_cong[df_cong['count_aisle_learner_jhs'] > 0]['school_id'].tolist())\n",
    "print(f\"Included in optimization: {len(included_ids):,}\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 35,
   "id": "v2w3x4y5",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "\n",
      "Report 3A - Excluded Public Schools: 318\n"
     ]
    },
    {
     "data": {
      "text/plain": [
       "exclusion_reason\n",
       "Not congested (no aisle learners)               277\n",
       "No JHS enrollment data                           38\n",
       "Not in distance matrix (missing coordinates)      3\n",
       "Name: count, dtype: int64"
      ]
     },
     "metadata": {},
     "output_type": "display_data"
    }
   ],
   "source": [
    "# Determine exclusion reasons\n",
    "report3a = all_public_jhs.copy()\n",
    "report3a.columns = ['school_id', 'school_name', 'division', 'region']\n",
    "\n",
    "# Check various exclusion conditions\n",
    "in_enrollment = set(dict_jhs_enrollment.keys())\n",
    "in_distance_matrix = set(re_schids)\n",
    "in_df_cong = set(df_cong['school_id'].tolist())\n",
    "not_congested = set(df_cong[df_cong['count_aisle_learner_jhs'] == 0]['school_id'].tolist())\n",
    "\n",
    "def get_exclusion_reason(school_id):\n",
    "    if school_id in included_ids:\n",
    "        return None  # Not excluded\n",
    "    if school_id not in in_enrollment:\n",
    "        return \"No JHS enrollment data\"\n",
    "    if school_id not in in_distance_matrix:\n",
    "        return \"Not in distance matrix (missing coordinates)\"\n",
    "    if school_id in not_congested:\n",
    "        return \"Not congested (no aisle learners)\"\n",
    "    return \"Other\"\n",
    "\n",
    "report3a['exclusion_reason'] = report3a['school_id'].apply(get_exclusion_reason)\n",
    "\n",
    "# Filter to only excluded schools\n",
    "report3a = report3a[report3a['exclusion_reason'].notna()].copy()\n",
    "report3a = report3a.sort_values(['exclusion_reason', 'division'])\n",
    "\n",
    "print(f\"\\nReport 3A - Excluded Public Schools: {report3a.shape[0]:,}\")\n",
    "display(report3a['exclusion_reason'].value_counts())"
   ]
  },
