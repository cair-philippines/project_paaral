   "cell_type": "markdown",
   "id": "a1b2c3d4",
   "metadata": {},
   "source": [
    "# 2.5. Scenario 1 Stakeholder Reports\n",
    "\n",
    "**Purpose:** Generate CSV reports to communicate Scenario 1 optimization results to stakeholders.\n",
    "\n",
    "**Reports Generated:**\n",
    "1. **Public JHS Congestion Summary** - One row per congested school with baseline, intervention results, and **top 3 private ESC partners**\n",
    "2. **Public-Private Redirection Pairs** - Which private schools help which public schools (detailed view)\n",
    "3. **Excluded Schools** - Schools not included in optimization and why\n",
    "\n",
    "**Prerequisite:** Run notebook 2.4 first to generate optimization results."
   ]
  },
  {
   "cell_type": "markdown",
   "id": "b1c2d3e4",
   "metadata": {},
   "source": [
    "# 0.0. Setup"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 1,
   "id": "c1d2e3f4",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Reports will be saved to: output/reports\n"
     ]
    }
   ],
   "source": [
    "import os\n",
    "import json\n",
    "import copy\n",
    "import numpy as np\n",
    "import pandas as pd\n",
    "from pathlib import Path\n",
    "\n",
    "from sklearn.impute import KNNImputer\n",
    "from sklearn.preprocessing import MinMaxScaler\n",
    "from sklearn.pipeline import Pipeline\n",
    "from sklearn.compose import ColumnTransformer\n",
    "from sklearn.impute import SimpleImputer\n",
    "from category_encoders import BinaryEncoder\n",
    "\n",
    "from pulp import LpMaximize, LpProblem, LpVariable, lpSum, LpStatus, value\n",
    "\n",
    "pd.set_option('display.max_columns', None)\n",
    "\n",
    "PROJECT_DIR = Path.cwd().parent\n",
    "if 'modules' not in os.listdir(Path.cwd()):\n",
    "    os.chdir(PROJECT_DIR)\n",
    "\n",
    "DATA_DIR = 'data'\n",
    "OUTPUT_DIR = 'output'\n",
    "REPORTS_DIR = 'output/reports'\n",
    "\n",
    "# Create reports directory if it doesn't exist\n",
    "os.makedirs(REPORTS_DIR, exist_ok=True)\n",
    "print(f\"Reports will be saved to: {REPORTS_DIR}\")"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "d1e2f3g4",
   "metadata": {},
   "source": [
    "# 1.0. Load and Recreate Data from Notebook 2.4\n",
    "\n",
    "We need to recreate the key dataframes from notebook 2.4 to generate reports."
   ]
  },
  {
   "cell_type": "markdown",
   "id": "e1f2g3h4",
   "metadata": {},
   "source": [
    "## 1.1. Load Base Data"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 2,
   "id": "f1g2h3i4",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "School info: (61442, 8)\n"
     ]
    }
   ],
   "source": [
    "# School info\n",
    "sch_info = pd.read_parquet('output/processed_project_bukas_school_information.parquet')\n",
    "essential_cols = ['school_id', 'school_name', 'old_region', 'division', 'sector', 'offers_es', 'offers_jhs', 'offers_shs']\n",
    "sch_info_slim = sch_info[essential_cols].copy()\n",
    "sch_info_slim['school_id'] = sch_info_slim['school_id'].astype(str)\n",
    "print(f\"School info: {sch_info_slim.shape}\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 3,
   "id": "g1h2i3j4",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Distance matrix shape: (8331, 8331)\n"
     ]
    }
   ],
   "source": [
    "# Distance matrix and index\n",
    "distance_matrix = np.load('output/school_distance_matrix_osrm.npy')\n",
    "with open('output/school_distance_matrix_index.json', 'r') as f:\n",
    "    index_data = json.load(f)\n",
    "    school_ids = index_data['school_ids']\n",
    "    school_id_to_idx = index_data['school_id_to_indices']\n",
    "print(f\"Distance matrix shape: {distance_matrix.shape}\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 4,
   "id": "h1i2j3k4",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Trimmed distance matrix: (8307, 8307)\n"
     ]
    }
   ],
   "source": [
    "# Trim distance matrix (same as notebook 2.4 Section 1.2)\n",
    "dupe_ids = [(schid, ids) for schid, ids in school_id_to_idx.items() if len(ids) == 2]\n",
    "idxs_to_drop = [max(int(tup[1][0]), int(tup[1][1])) for tup in dupe_ids]\n",
    "\n",
    "schid_idx = copy.deepcopy(school_id_to_idx)\n",
    "for schid, ids in school_id_to_idx.items():\n",
    "    schid_idx[schid] = ids[0]\n",
    "\n",
    "re_schids_to_idx = {schid: n for schid, n in zip(schid_idx, range(0, len(schid_idx.keys())))}\n",
    "re_schids = list(re_schids_to_idx.keys())\n",
    "\n",
    "dm = distance_matrix.copy()\n",
    "dm = np.delete(dm, idxs_to_drop, axis=1)\n",
    "dm = np.delete(dm, idxs_to_drop, axis=0)\n",
    "print(f\"Trimmed distance matrix: {dm.shape}\")\n",
    "\n",
    "del distance_matrix"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 5,
   "id": "i1j2k3l4",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Student flow: (288328, 4)\n"
     ]
    }
   ],
   "source": [
    "# Student flow\n",
    "student_flow = pd.read_parquet('output/grade_7_student_flow_table_sy2324.parquet')\n",
    "print(f\"Student flow: {student_flow.shape}\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 6,
   "id": "j1k2l3m4",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Public seats: (54360, 3)\n"
     ]
    }
   ],
   "source": [
    "# Public seats\n",
    "public_seats = pd.read_parquet('output/processed_public_seats.parquet')\n",
    "public_seats['school_id'] = public_seats['school_id'].astype(str)\n",
    "print(f\"Public seats: {public_seats.shape}\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 7,
   "id": "k1l2m3n4",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "JHS enrollment records: 16,376\n"
     ]
    }
   ],
   "source": [
    "# Enrollment\n",
    "enrollment = pd.read_parquet('output/processed_project_bukas_school_enrollment.parquet')\n",
    "mask = (enrollment['school_year'] == '2023_24') & (enrollment['education_level'] == 'junior_high_school')\n",
    "jhs_enrollment = enrollment[mask].groupby(['school_id'], as_index=False)['enrollment_count'].sum()\n",
    "dict_jhs_enrollment = {schid: enr for schid, enr in zip(jhs_enrollment['school_id'], jhs_enrollment['enrollment_count'])}\n",
    "print(f\"JHS enrollment records: {len(dict_jhs_enrollment):,}\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 8,
   "id": "l1m2n3o4",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Coordinates: (8331, 4)\n"
     ]
    }
   ],
   "source": [
    "# Coordinates\n",
    "coordinates = pd.read_parquet('output/all_schools_coordinates_ncr_region4a.parquet')\n",
    "print(f\"Coordinates: {coordinates.shape}\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 9,
   "id": "m1n2o3p4",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "ESC slots: (4550, 7)\n",
      "GASTPE tuition data: (5188, 5)\n"
     ]
    }
   ],
   "source": [
    "# ESC slots\n",
    "esc_slots = pd.read_parquet('output/processed_esc_slots.parquet')\n",
    "print(f\"ESC slots: {esc_slots.shape}\")\n",
    "\n",
    "# GASTPE tuition data\n",
    "gastpe = pd.read_parquet('output/processed_gastpe_data.parquet')\n",
    "print(f\"GASTPE tuition data: {gastpe.shape}\")"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "n1o2p3q4",
   "metadata": {},
   "source": [
    "## 1.2. Recreate Congestion Table (df_cong)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 10,
   "id": "o1p2q3r4",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Public JHS in NCR/Region IV-A: 1,098\n"
     ]
    }
   ],
   "source": [
    "# Filter to Public JHS in NCR and Region IV-A\n",
    "import re\n",
    "mask = (\n",
    "    (sch_info_slim['sector'] == 'Public')\n",
    "    & (sch_info_slim['offers_jhs'] == True)\n",
    "    & (sch_info_slim['old_region'].isin(['NCR', 'Region IV-A']))\n",
    ")\n",
    "sch_public_jhs = sch_info_slim.loc[mask].copy()\n",
    "drop_cols = [col for col in sch_public_jhs.columns if re.search(r'offers_|sector', col)]\n",
    "sch_public_jhs.drop(columns=drop_cols, inplace=True)\n",
    "print(f\"Public JHS in NCR/Region IV-A: {sch_public_jhs.shape[0]:,}\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 11,
   "id": "p1q2r3s4",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "With enrollment data: 1,060\n"
     ]
    }
   ],
   "source": [
    "# Join enrollment\n",
    "tmp_jn = sch_public_jhs.copy()\n",
    "tmp_jn['enrollment_jhs'] = tmp_jn['school_id'].apply(lambda schid: dict_jhs_enrollment.get(schid))\n",
    "mask = tmp_jn['school_id'].isin(list(dict_jhs_enrollment.keys()))\n",
    "tmp_jn = tmp_jn[mask]\n",
    "print(f\"With enrollment data: {tmp_jn.shape[0]:,}\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 12,
   "id": "q1r2s3t4",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Missing seats: 41\n"
     ]
    }
   ],
   "source": [
    "# Join seats\n",
    "enr_seats = tmp_jn.merge(\n",
    "    public_seats[public_seats['education_level'] == 'Junior High School'],\n",
    "    on='school_id',\n",
    "    how='left'\n",
    ").drop(columns=['education_level'])\n",
    "print(f\"Missing seats: {enr_seats['seat_count'].isna().sum()}\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 13,
   "id": "r1s2t3u4",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Imputed seats for 41 schools\n"
     ]
    }
   ],
   "source": [
    "# KNN Imputation for missing seats\n",
    "df_imp = enr_seats.copy()\n",
    "df_imp = df_imp.merge(coordinates.drop(columns='sector'), on='school_id', how='left')\n",
    "drop_cols = ['school_name']\n",
    "df_imp.drop(columns=drop_cols, inplace=True)\n",
    "df_imp.set_index('school_id', inplace=True)\n",
    "\n",
    "imputed_seats_schids = df_imp[df_imp['seat_count'].isna()].index.tolist()\n",
    "\n",
    "cat_cols = ['old_region', 'division']\n",
    "num_cols = ['enrollment_jhs', 'seat_count', 'longitude', 'latitude']\n",
    "\n",
    "cat_transformer = Pipeline([\n",
    "    ('impute_cat', SimpleImputer(strategy='constant', fill_value='missing')),\n",
    "    ('binary_enc', BinaryEncoder())\n",
    "])\n",
    "\n",
    "preprocessor = ColumnTransformer(\n",
    "    transformers=[\n",
    "        ('cat_logic', cat_transformer, cat_cols),\n",
    "        ('num_logic', 'passthrough', num_cols)\n",
    "    ]\n",
    ")\n",
    "\n",
    "final_pipeline = Pipeline([\n",
    "    ('prep', preprocessor),\n",
    "    ('scale', MinMaxScaler()),\n",
    "    ('knn_impute', KNNImputer(n_neighbors=5))\n",
    "])\n",
    "\n",
    "processed_data = final_pipeline.fit_transform(df_imp)\n",
    "scaler = final_pipeline.named_steps['scale']\n",
    "unscaled_data = scaler.inverse_transform(processed_data)\n",
    "feat_names = final_pipeline.named_steps['prep'].get_feature_names_out()\n",
    "df_unscaled = pd.DataFrame(unscaled_data, columns=feat_names)\n",
    "final_seats = df_unscaled['num_logic__seat_count']\n",
    "\n",
    "df_imputed = df_imp.copy()\n",
    "df_imputed['seat_count'] = final_seats.values\n",
    "df_imputed.reset_index(inplace=True)\n",
    "df_imputed.drop(columns=['longitude', 'latitude'], inplace=True)\n",
    "df_imputed['is_seats_imputed'] = df_imputed['school_id'].isin(imputed_seats_schids)\n",
    "\n",
    "print(f\"Imputed seats for {len(imputed_seats_schids)} schools\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 14,
   "id": "s1t2u3v4",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Congestion table: (1060, 9)\n",
      "Congested schools: 780\n",
      "Total aisle learners: 689,568\n"
     ]
    }
   ],
   "source": [
    "# Calculate congestion metrics\n",
    "df_cong = df_imputed.copy()\n",
    "df_cong['seat_utilization_jhs'] = df_cong['enrollment_jhs'] / df_cong['seat_count']\n",
    "df_cong['count_aisle_learner_jhs'] = df_cong['enrollment_jhs'] - df_cong['seat_count']\n",
    "mask = df_cong['count_aisle_learner_jhs'] <= 0\n",
    "df_cong.loc[mask, 'count_aisle_learner_jhs'] = 0\n",
    "\n",
    "df_cong = df_cong.merge(sch_info_slim[['school_id', 'school_name']], on='school_id', how='left')\n",
    "\n",
    "print(f\"Congestion table: {df_cong.shape}\")\n",
    "print(f\"Congested schools: {(df_cong['count_aisle_learner_jhs'] > 0).sum():,}\")\n",
    "print(f\"Total aisle learners: {df_cong['count_aisle_learner_jhs'].sum():,.0f}\")"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "t1u2v3w4",
   "metadata": {},
   "source": [
    "## 1.3. Recreate ESC and Flow Data"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 15,
   "id": "u1v2w3x4",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "ESC schools in location: 1,058\n"
     ]
    }
   ],
   "source": [
    "# Filter ESC to NCR/Region IV-A\n",
    "mask = esc_slots['school_id'].isin(re_schids)\n",
    "esc_in_loc = esc_slots[['school_id', 'total_count_slots']].loc[mask].copy()\n",
    "print(f\"ESC schools in location: {esc_in_loc.shape[0]:,}\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 16,
   "id": "v1w2x3y4",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Flow pairs in location: 57,261\n"
     ]
    }
   ],
   "source": [
    "# Filter flow to NCR/Region IV-A\n",
    "mask = (\n",
    "    (student_flow['school_id_origin'].isin(re_schids))\n",
    "    & (student_flow['school_id_destination'].isin(re_schids))\n",
    ")\n",
    "flow = student_flow[mask].copy()\n",
    "print(f\"Flow pairs in location: {flow.shape[0]:,}\")"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "w1x2y3z4",
   "metadata": {},
   "source": [
    "## 1.4. Build Redirection Options"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 17,
   "id": "x1y2z3a5",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Flows to congested public JHS: 23,893\n"
     ]
    }
   ],
   "source": [
    "# Link flow to congestion\n",
    "flow_to_congested = flow.merge(\n",
    "    df_cong[['school_id', 'count_aisle_learner_jhs', 'seat_utilization_jhs', 'enrollment_jhs', 'seat_count']],\n",
    "    left_on='school_id_destination',\n",
    "    right_on='school_id',\n",
    "    how='inner'\n",
    ").drop(columns='school_id')\n",
    "\n",
    "mask = flow_to_congested['count_aisle_learner_jhs'] > 0\n",
    "flow_to_congested = flow_to_congested[mask].copy()\n",
    "print(f\"Flows to congested public JHS: {flow_to_congested.shape[0]:,}\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 18,
   "id": "y1z2a3b5",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Origin-to-private pairs: 50,675\n"
     ]
    }
   ],
   "source": [
    "# Build origin-to-private distance lookup\n",
    "MAX_DISTANCE_KM = 5\n",
    "\n",
    "public_jhs_ids = df_cong['school_id'].tolist()\n",
    "private_esc_ids = esc_in_loc['school_id'].tolist()\n",
    "public_in_dm = [sid for sid in public_jhs_ids if sid in re_schids_to_idx]\n",
    "private_in_dm = [sid for sid in private_esc_ids if sid in re_schids_to_idx]\n",
    "\n",
    "origin_ids = flow_to_congested['school_id_origin'].unique().tolist()\n",
    "origins_in_dm = [sid for sid in origin_ids if sid in re_schids_to_idx]\n",
    "\n",
    "rows = []\n",
    "for orig_id in origins_in_dm:\n",
    "    orig_idx = re_schids_to_idx[orig_id]\n",
    "    for priv_id in private_in_dm:\n",
    "        priv_idx = re_schids_to_idx[priv_id]\n",
    "        distance_m = dm[orig_idx, priv_idx]\n",
    "        if distance_m <= MAX_DISTANCE_KM * 1000:\n",
    "            rows.append({\n",
    "                'school_id_origin': orig_id,\n",
    "                'private_esc_id': priv_id,\n",
    "                'distance_to_private_m': distance_m,\n",
    "                'distance_to_private_km': distance_m / 1000\n",
    "            })\n",
    "\n",
    "origin_to_private = pd.DataFrame(rows)\n",
    "origin_to_private = origin_to_private.merge(\n",
    "    esc_in_loc[['school_id', 'total_count_slots']],\n",
    "    left_on='private_esc_id',\n",
    "    right_on='school_id',\n",
    "    how='left'\n",
    ").drop(columns='school_id')\n",
    "\n",
    "print(f\"Origin-to-private pairs: {origin_to_private.shape[0]:,}\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 19,
   "id": "z1a2b3c5",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Redirection options: 332,864\n"
     ]
    }
   ],
   "source": [
    "# Create redirection options\n",
    "redirection_options = flow_to_congested.merge(\n",
    "    origin_to_private,\n",
    "    on='school_id_origin',\n",
    "    how='inner'\n",
    ")\n",
    "print(f\"Redirection options: {redirection_options.shape[0]:,}\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 20,
   "id": "a2b3c4d5",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "ESC schools with available slots > 0: 951\n",
      "Total available slots: 27,141\n"
     ]
    }
   ],
   "source": [
    "# Calculate available slots\n",
    "current_benef = flow.groupby('school_id_destination', as_index=False)['count_esc_beneficiary'].sum()\n",
    "current_benef.columns = ['school_id', 'current_beneficiaries']\n",
    "current_benef['current_beneficiaries'] = current_benef['current_beneficiaries'].fillna(0)\n",
    "\n",
    "esc_available = esc_in_loc.merge(current_benef, on='school_id', how='left')\n",
    "esc_available['current_beneficiaries'] = esc_available['current_beneficiaries'].fillna(0)\n",
    "esc_available['available_slots'] = esc_available['total_count_slots'] - esc_available['current_beneficiaries']\n",
    "mask = esc_available['available_slots'] < 0\n",
    "esc_available.loc[mask, 'available_slots'] = 0\n",
    "\n",
    "print(f\"ESC schools with available slots > 0: {(esc_available['available_slots'] > 0).sum():,}\")\n",
    "print(f\"Total available slots: {esc_available['available_slots'].sum():,.0f}\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 21,
   "id": "b2c3d4e5",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Redirection options with available slots: 292,719\n",
      "Tuition range: 8,480 - 166,992\n",
      "Median tuition: 39,942\n"
     ]
    },
    {
     "name": "stderr",
     "output_type": "stream",
     "text": [
      "/tmp/ipykernel_13026/2690775653.py:24: FutureWarning: A value is trying to be set on a copy of a DataFrame or Series through chained assignment using an inplace method.\n",
