   "source": [
    "# Schools used in LP optimization\n",
    "used_private_ids = set(redirections_lp['private_esc_id'].unique())\n",
    "print(f\"Private ESC schools used in optimization: {len(used_private_ids):,}\")\n",
    "\n",
    "# Determine exclusion reasons\n",
    "in_location = set(esc_in_loc['school_id'].tolist())  # NCR/Region IV-A\n",
    "has_available_slots = set(esc_available[esc_available['available_slots'] > 0]['school_id'].tolist())\n",
    "in_redirection_options = set(redirection_options['private_esc_id'].unique())\n",
    "\n",
    "def get_private_exclusion_reason(row):\n",
    "    school_id = row['school_id']\n",
    "    if school_id in used_private_ids:\n",
    "        return None  # Not excluded\n",
    "    if row['old_region'] not in ['NCR', 'Region IV-A']:\n",
    "        return \"Outside NCR/Region IV-A\"\n",
    "    if school_id not in in_distance_matrix:\n",
    "        return \"Not in distance matrix (missing coordinates)\"\n",
    "    if school_id not in has_available_slots:\n",
    "        return \"No available slots (fully occupied)\"\n",
    "    if school_id not in in_redirection_options:\n",
    "        return \"No nearby origin schools within 15km\"\n",
    "    return \"Not selected by LP (slots used elsewhere)\"\n",
    "\n",
    "all_esc['exclusion_reason'] = all_esc.apply(get_private_exclusion_reason, axis=1)\n",
    "\n",
    "# Filter to only excluded schools\n",
    "report3b = all_esc[all_esc['exclusion_reason'].notna()].copy()\n",
    "report3b = report3b[['school_id', 'school_name', 'division', 'old_region', \n",
    "                      'total_count_slots', 'current_beneficiaries', 'available_slots', 'exclusion_reason']]\n",
    "report3b.columns = ['school_id', 'school_name', 'division', 'region',\n",
    "                    'total_slots', 'current_beneficiaries', 'available_slots', 'exclusion_reason']\n",
    "report3b = report3b.sort_values(['exclusion_reason', 'division'])\n",
    "\n",
    "print(f\"\\nReport 3B - Excluded Private ESC Schools: {report3b.shape[0]:,}\")\n",
    "display(report3b['exclusion_reason'].value_counts())"
   ]
