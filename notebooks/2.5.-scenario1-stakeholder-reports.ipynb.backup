    }
   ],
   "source": [
    "# Update redirection options with available slots\n",
    "redirection_options = redirection_options.drop(columns=['total_count_slots'])\n",
    "redirection_options = redirection_options.merge(\n",
    "    esc_available[['school_id', 'available_slots']],\n",
    "    left_on='private_esc_id',\n",
    "    right_on='school_id',\n",
    "    how='left'\n",
    ").drop(columns='school_id')\n",
    "\n",
    "redirection_options = redirection_options[redirection_options['available_slots'] > 0].copy()\n",
    "print(f\"Redirection options with available slots: {redirection_options.shape[0]:,}\")\n",
    "\n",
    "# Add tuition fees to redirection options\n",
    "redirection_options = redirection_options.merge(\n",
    "    gastpe[['school_id', 'average_jhs_total_fees']],\n",
    "    left_on='private_esc_id',\n",
    "    right_on='school_id',\n",
    "    how='left'\n",
    ").drop(columns=['school_id'])\n",
    "redirection_options.rename(columns={'average_jhs_total_fees': 'tuition_jhs'}, inplace=True)\n",
    "\n",
    "# Handle missing tuition (use median as fallback)\n",
    "median_tuition = redirection_options['tuition_jhs'].median()\n",
    "redirection_options['tuition_jhs'].fillna(median_tuition, inplace=True)\n",
    "\n",
    "# Pre-compute normalized tuition for priority scoring\n",
    "tuition_min = redirection_options['tuition_jhs'].min()\n",
    "tuition_max = redirection_options['tuition_jhs'].max()\n",
    "redirection_options['norm_tuition'] = (redirection_options['tuition_jhs'] - tuition_min) / (tuition_max - tuition_min + 1e-6)\n",
    "\n",
    "print(f\"Tuition range: {tuition_min:,.0f} - {tuition_max:,.0f}\")\n",
    "print(f\"Median tuition: {median_tuition:,.0f}\")"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "c2d3e4f5",
   "metadata": {},
   "source": [
    "## 1.5. Run Greedy Optimization"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 22,
   "id": "d2e3f4g5",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Greedy redirections: 5,145\n",
      "Total students redirected (Greedy): 26,451\n"
     ]
    }
   ],
   "source": [
    "# Initialize tracking\n",
    "remaining_slots = esc_available.set_index('school_id')['available_slots'].to_dict()\n",
    "remaining_aisle = df_cong.set_index('school_id')['count_aisle_learner_jhs'].to_dict()\n",
    "\n",
    "# NEW: Track remaining non-beneficiaries per (origin, destination) pair\n",
    "# This prevents over-redirecting from a single flow when multiple private ESC options exist\n",
    "remaining_non_benef = flow_to_congested.set_index(\n",
    "    ['school_id_origin', 'school_id_destination']\n",
    ")['count_non_beneficiary'].to_dict()\n",
    "\n",
    "redirection_log = []\n",
    "\n",
    "# Tuning parameter for tuition weight\n",
    "TUITION_WEIGHT = 0.5  # 0 = ignore tuition, 1 = equal weight to distance\n",
    "\n",
    "# Get congested public JHS sorted by severity\n",
    "congested_jhs = df_cong[df_cong['count_aisle_learner_jhs'] > 0].copy()\n",
    "congested_jhs = congested_jhs.sort_values('count_aisle_learner_jhs', ascending=False)\n",
    "congested_jhs_ids = congested_jhs['school_id'].tolist()\n",
    "\n",
    "# Greedy loop\n",
    "for pub_jhs_id in congested_jhs_ids:\n",
    "    if remaining_aisle.get(pub_jhs_id, 0) <= 0:\n",
    "        continue\n",
    "    \n",
    "    options = redirection_options[\n",
    "        redirection_options['school_id_destination'] == pub_jhs_id\n",
    "    ].copy()\n",
    "    \n",
    "    # Calculate priority score (balances distance AND tuition cost)\n",
    "    dist_min = options['distance_to_private_km'].min()\n",
    "    dist_max = options['distance_to_private_km'].max()\n",
    "    options['norm_distance'] = (options['distance_to_private_km'] - dist_min) / (dist_max - dist_min + 1e-6)\n",
    "    options['priority_score'] = options['norm_distance'] + TUITION_WEIGHT * options['norm_tuition']\n",
    "    \n",
    "    # Sort by priority (lowest = nearest + cheapest)\n",
    "    options = options.sort_values('priority_score', ascending=True)\n",
    "    \n",
    "    for _, row in options.iterrows():\n",
    "        aisle_left = remaining_aisle.get(pub_jhs_id, 0)\n",
    "        if aisle_left <= 0:\n",
    "            break\n",
    "        \n",
    "        origin_id = row['school_id_origin']\n",
    "        private_id = row['private_esc_id']\n",
    "        distance_km = row['distance_to_private_km']\n",
    "        tuition = row['tuition_jhs']\n",
    "        \n",
    "        # Get remaining non-beneficiaries for THIS specific flow\n",
    "        flow_key = (origin_id, pub_jhs_id)\n",
    "        non_benef_left = remaining_non_benef.get(flow_key, 0)\n",
    "        if non_benef_left <= 0:\n",
    "            continue  # No more students to redirect from this flow\n",
    "        \n",
    "        slots_left = remaining_slots.get(private_id, 0)\n",
    "        if slots_left <= 0:\n",
    "            continue\n",
    "        \n",
    "        # Use remaining non-beneficiaries, not original count\n",
    "        count_to_redirect = min(non_benef_left, slots_left, aisle_left)\n",
    "        \n",
    "        if count_to_redirect > 0:\n",
    "            redirection_log.append({\n",
    "                'school_id_origin': origin_id,\n",
    "                'school_id_destination': pub_jhs_id,\n",
    "                'private_esc_id': private_id,\n",
    "                'count_redirected': count_to_redirect,\n",
    "                'distance_to_private_km': distance_km,\n",
    "                'tuition_jhs': tuition\n",
    "            })\n",
    "            remaining_slots[private_id] -= count_to_redirect\n",
    "            remaining_aisle[pub_jhs_id] -= count_to_redirect\n",
    "            remaining_non_benef[flow_key] -= count_to_redirect  # Decrement flow\n",
    "\n",
    "redirections = pd.DataFrame(redirection_log)\n",
    "print(f\"Greedy redirections: {len(redirections):,}\")\n",
    "print(f\"Total students redirected (Greedy): {redirections['count_redirected'].sum():,.0f}\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 23,
   "id": "e2f3g4h5",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Baseline aisle learners: 689,568\n",
      "Greedy aisle learners: 663,117\n",
      "Greedy reduction: 26,451 (3.8%)\n"
     ]
    }
   ],
   "source": [
    "# Create greedy congestion results\n",
    "scenario1_congestion = df_cong.copy()\n",
    "scenario1_congestion['count_aisle_learner_jhs_s1'] = scenario1_congestion['school_id'].map(remaining_aisle)\n",
    "scenario1_congestion['aisle_learner_reduction'] = (\n",
    "    scenario1_congestion['count_aisle_learner_jhs'] - scenario1_congestion['count_aisle_learner_jhs_s1']\n",
    ")\n",
    "\n",
    "baseline_aisle = df_cong['count_aisle_learner_jhs'].sum()\n",
    "greedy_aisle = scenario1_congestion['count_aisle_learner_jhs_s1'].sum()\n",
    "print(f\"Baseline aisle learners: {baseline_aisle:,.0f}\")\n",
    "print(f\"Greedy aisle learners: {greedy_aisle:,.0f}\")\n",
    "print(f\"Greedy reduction: {baseline_aisle - greedy_aisle:,.0f} ({((baseline_aisle - greedy_aisle)/baseline_aisle)*100:.1f}%)\")"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "f2g3h4i5",
   "metadata": {},
   "source": [
    "## 1.6. Run LP Optimization"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 24,
   "id": "g2h3i4j5",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Flow constraints: 23,893\n",
      "Slot constraints: 1,058\n",
      "Aisle constraints: 1,060\n"
     ]
    }
   ],
   "source": [
    "# Prepare constraint dictionaries\n",
    "flow_limits = flow_to_congested.groupby(\n",
    "    ['school_id_origin', 'school_id_destination']\n",
    ")['count_non_beneficiary'].first().to_dict()\n",
    "\n",
    "slot_limits = esc_available.set_index('school_id')['available_slots'].to_dict()\n",
    "aisle_limits = df_cong.set_index('school_id')['count_aisle_learner_jhs'].to_dict()\n",
    "\n",
    "print(f\"Flow constraints: {len(flow_limits):,}\")\n",
    "print(f\"Slot constraints: {len(slot_limits):,}\")\n",
    "print(f\"Aisle constraints: {len(aisle_limits):,}\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 25,
   "id": "h2i3j4k5",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Decision variables: 292,719\n"
     ]
    }
   ],
   "source": [
    "# Setup LP\n",
    "prob = LpProblem(\"Minimize_Aisle_Learners\", LpMaximize)\n",
    "\n",
    "x = {}\n",
    "for idx in redirection_options.index:\n",
    "    x[idx] = LpVariable(f\"x_{idx}\", lowBound=0, cat='Continuous')\n",
    "\n",
    "print(f\"Decision variables: {len(x):,}\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 26,
   "id": "i2j3k4l5",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Constraints added\n"
     ]
    }
   ],
   "source": [
    "# Add constraints\n",
    "# Flow constraints\n",
    "flow_groups = redirection_options.groupby(['school_id_origin', 'school_id_destination'])\n",
    "for (origin, dest), group in flow_groups:\n",
    "    flow_limit = flow_limits.get((origin, dest), 0)\n",
    "    prob += (lpSum([x[idx] for idx in group.index]) <= flow_limit, f\"flow_{origin}_{dest}\")\n",
    "\n",
    "# Slot constraints\n",
    "private_groups = redirection_options.groupby('private_esc_id')\n",
    "for private_id, group in private_groups:\n",
    "    slot_limit = slot_limits.get(private_id, 0)\n",
    "    prob += (lpSum([x[idx] for idx in group.index]) <= slot_limit, f\"slots_{private_id}\")\n",
    "\n",
    "# Aisle constraints\n",
    "dest_groups = redirection_options.groupby('school_id_destination')\n",
    "for dest_id, group in dest_groups:\n",
    "    aisle_limit = aisle_limits.get(dest_id, 0)\n",
    "    prob += (lpSum([x[idx] for idx in group.index]) <= aisle_limit, f\"aisle_{dest_id}\")\n",
    "\n",
    "print(\"Constraints added\")"
   ]
  },
