   "source": [
    "# Aggregate LP redirections by (public JHS, private ESC) pair\n",
    "pair_agg = redirections_lp.groupby(\n",
    "    ['school_id_destination', 'private_esc_id']\n",
    ").agg({\n",
    "    'count_redirected_lp': 'sum',\n",
    "    'distance_to_private_km': 'mean',\n",
    "    'school_id_origin': 'nunique'\n",
    "}).reset_index()\n",
    "\n",
    "pair_agg.columns = ['public_jhs_id', 'private_esc_id', 'count_redirected', 'avg_distance_km', 'num_origin_schools']\n",
    "\n",
    "print(f\"Unique public-private pairs: {pair_agg.shape[0]:,}\")"
   ]
  },
